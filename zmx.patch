+pub fn oldProtocol(socket_path: []const u8) bool {
+    const fd = connectSession(socket_path) catch return false;
+    defer lib_posix.close(fd);
+    send(fd, .Info, "") catch return false;
+    send(fd, .LabelGet, "") catch {};
+    var poll_fds = [_]lib_posix.pollfd{.{ .fd = fd, .events = lib_posix.POLL.IN, .revents = 0 }};
+    if ((lib_posix.poll(&poll_fds, 1000) catch return false) == 0) return false;
+    var reply: [@sizeOf(Header)]u8 = undefined;
+    const n = lib_posix.read(fd, &reply) catch return false;
+    return n >= 2 and reply[1] != PROTOCOL_VERSION;
