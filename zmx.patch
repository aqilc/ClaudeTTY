+    const sibling = try std.fs.path.join(gpa, &.{ dir[0..n], "zmx-0.8" });
+    const forwarded = try gpa.alloc([]const u8, argv.len);
+    for (forwarded, argv) |*to, from| to.* = from;
+    forwarded[0] = sibling;
+    const err = std.process.replace(io, .{ .argv = forwarded });
+    printError(io, "session \"{s}\" runs zmx 0.8 and {s} can't run ({s})", .{ argv[i], sibling, @errorName(err) });
+}
