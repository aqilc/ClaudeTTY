+fn forwardOld(gpa: std.mem.Allocator, io: std.Io, cfg: *Cfg, args: std.process.Args) !void {
+    const argv = try args.toSlice(gpa);
+    defer gpa.free(argv);
+    var i: usize = 2;
+    while (i < argv.len and std.mem.startsWith(u8, argv[i], "-")) : (i += 1) {
+        if (std.mem.eql(u8, argv[i], "--labels")) i += 1;
+    }
+    if (i >= argv.len) return;
+    const sesh = socket.getSeshName(gpa, argv[i]) catch return;
+    defer gpa.free(sesh);
+    const socket_path = socket.getSocketPath(gpa, cfg.socket_dir, sesh) catch return;
+    defer gpa.free(socket_path);
